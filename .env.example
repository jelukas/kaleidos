# Copia este archivo a .env (está en .gitignore) y rellena los valores. Nunca los pegues en el chat.

# --- AWS: usuario IAM kaleidos-render-pruebas (política aws/politica-usuario-combinada.json) ---
# Remotion Lambda
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=eu-west-1
# HyperFrames Lambda, AWS SDK, SAM y AWS CLI (mismas claves)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# --- Generativa (scripts/ y skill video-corto) ---
# ElevenLabs: endpoint LOCAL compatible (proxy) + clave, voz y modelo por defecto
ELEVENLABS_BASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
# Imágenes (gpt-image-2)
OPENAI_API_KEY=
OPENAI_BASE_URL=
IMAGE_MODEL=
IMAGE_MODEL_AMBIENT=
IMAGE_QUALITY=
# Fotografía real (Apify)
APIFY_API_KEY=
