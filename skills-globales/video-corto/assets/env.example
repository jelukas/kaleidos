# ─── Voz: ElevenLabs ─────────────────────────────────────────────────────────
# El script llama a:  POST {ELEVENLABS_BASE_URL}/v1/text-to-speech/{voice_id}
# Sirve tanto la API real como cualquier proxy local que imite esa forma.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
# Voz por defecto (se puede sobreescribir por vídeo en script.json)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── Imágenes: OpenAI gpt-image-2 ────────────────────────────────────────────
OPENAI_API_KEY=
# Cambiar solo si usas un proxy/gateway propio
OPENAI_BASE_URL=https://api.openai.com
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low

# ─── Imágenes reales: Apify hooli/google-images-scraper ──────────────────────
# Para lo que gpt-image-2 no puede inventar: personas, hechos, actualidad.
# Coste aproximado: 1,90 $ / 1000 imágenes devueltas.
APIFY_API_KEY=
